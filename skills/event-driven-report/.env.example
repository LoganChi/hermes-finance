# ===== event-driven-report · 环境变量 =====
# 复制为 .env 并填入真实值（.env 已在 .gitignore，不入库）。
# 或直接设系统/用户级环境变量。

# LLM（必需，缺失会静默降级 mock，结果仅 demo）
# DeepSeek 官方 key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 行情数据源（可选，默认走 akshare 免费，无需 token）
# 仅当 settings.yaml 把 data.backend 改为 tushare 时需要
# TUSHARE_TOKEN=

# ===== PowerShell 加载方式（参考）=====
# 临时（当前会话）: $env:DEEPSEEK_API_KEY = 'sk-xxx'
# 从用户级读取:     $env:DEEPSEEK_API_KEY = [Environment]::GetEnvironmentVariable('DEEPSEEK_API_KEY','User')
# 持久化:           setx DEEPSEEK_API_KEY "sk-xxx"
